{
  "kind": "edit_fields",
  "version": "0.1.0",
  "title": "Edit Fields",
  "description": "Set, rename, copy or remove fields of each JSON message without code.",
  "repository_url": "https://github.com/HackInvent/bloxmith-edit-fields",
  "bloxsmith_compatibility": [
    "1.0.9"
  ],
  "tested_with_bloxsmith": "1.0.9",
  "prerequisites": [],
  "locales": {
    "en": "locales/en.json",
    "fr": "locales/fr.json"
  },
  "ports": {
    "inputs": [
      {
        "id": 1,
        "name": "in",
        "title": "in",
        "accepts": [
          "application/json",
          "message/*",
          "text/plain"
        ],
        "multiplicity": "one",
        "required": true,
        "execution_requirement": "required_for_execution"
      }
    ],
    "outputs": [
      {
        "id": 1,
        "name": "out",
        "title": "out",
        "emits": [
          "application/json"
        ],
        "multiplicity": "many"
      },
      {
        "id": 2,
        "name": "error",
        "title": "error",
        "emits": [
          "application/json"
        ],
        "multiplicity": "many"
      }
    ]
  },
  "config": {
    "mode": "edit",
    "apply_to": "message",
    "array_path": "",
    "max_items": 10000,
    "operations": [
      {
        "op": "set",
        "path": "processed",
        "value": true,
        "value_type": "boolean"
      }
    ],
    "on_missing": "skip",
    "parse_json": "auto",
    "on_error": "fail"
  },
  "port_capabilities": {
    "can_add_inputs": false,
    "can_add_outputs": false
  },
  "runtime": {
    "initial_state": "waiting",
    "runtime_executable": true,
    "active_worker": true,
    "centralized_executor": "generic",
    "centralized_dependency_mode": "all_inputs",
    "active_execution_policy": "on_each_event"
  },
  "ui_assets": {
    "modal": [
      {
        "kind": "css",
        "path": "assets/css/properties.css"
      },
      {
        "kind": "css",
        "path": "assets/css/editor.css"
      },
      {
        "kind": "js",
        "path": "assets/js/properties.js"
      },
      {
        "kind": "js",
        "path": "assets/js/settings.js"
      },
      {
        "kind": "js",
        "path": "assets/js/block_modal.js"
      }
    ],
    "inspector_panel": [
      {
        "kind": "css",
        "path": "assets/css/properties.css"
      },
      {
        "kind": "css",
        "path": "assets/css/editor.css"
      },
      {
        "kind": "js",
        "path": "assets/js/properties.js"
      },
      {
        "kind": "js",
        "path": "assets/js/settings.js"
      },
      {
        "kind": "js",
        "path": "assets/js/inspector_panel.js"
      }
    ],
    "node_card": [
      {
        "kind": "css",
        "path": "assets/css/node_card.css"
      }
    ]
  }
}
